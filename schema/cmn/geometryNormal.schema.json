{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "geometryNormal",
  "description": "Normal attribute. Defines the normals of the geometry.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "Float32"
      ],
      "description": "Must be: `Float32`"
    },
    "component": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "Number of coordinates per vertex position. Must be 3."
    },
    "encoding": {
      "type": "string",
      "enum": [
        "none"
      ],
      "description": "EncodingMust be: `none`"
    },
    "binding": {
      "type": "string",
      "enum": [
        "per-vertex"
      ],
      "description": "Must be: `per-vertex`"
    }
  },
  "required": [
    "type",
    "component"
  ],
  "x-i3s-versions": [
    "1.10",
    "1.9",
    "1.8",
    "1.7"
  ]
}
